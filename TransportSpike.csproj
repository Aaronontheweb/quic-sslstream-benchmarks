<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(ComparisonTargetFramework)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(ComparisonTargetFramework)' != ''">$(ComparisonTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;builds/**;evidence/**;.local/**;tools/**</DefaultItemExcludes>
    <LangVersion Condition="'$(ComparisonBuild)' == 'true'">15.0</LangVersion>
    <Features Condition="'$(ComparisonBuild)' == 'true'">$(Features);runtime-async=$(ComparisonRuntimeAsync)</Features>
    <RollForward Condition="'$(ComparisonBuild)' == 'true'">Disable</RollForward>
    <TieredCompilation Condition="'$(ComparisonBuild)' == 'true'">true</TieredCompilation>
  </PropertyGroup>
</Project>
